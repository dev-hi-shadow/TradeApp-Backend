PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/paper_trading
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
PRICE_TICK_MS=2000
DEFAULT_BALANCE=100000
CORS_ORIGIN=http://localhost:5173

# Public URL of the frontend (used to build password-reset links in emails).
# Defaults to the first CORS_ORIGIN entry if unset.
APP_URL=http://localhost:5173

# Password-reset email via Gmail + Google OAuth2.
# Leave blank in dev — the email service logs the reset link to the server
# console instead of sending, so the flow still works end-to-end.
# Setup: Google Cloud OAuth2 client (Gmail API / scope https://mail.google.com/),
# then mint a refresh token (e.g. via the OAuth Playground) for the sender.
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional friendly From header, e.g. "Tradar <no-reply@yourdomain.com>"
MAIL_FROM=
# Reset-link validity in minutes (default 30).
RESET_TOKEN_TTL_MIN=30
# Signup email-verification link validity in minutes (default 1440 = 24h).
VERIFY_TOKEN_TTL_MIN=1440

# Auth tokens. Short-lived access JWT + long-lived rotating refresh token.
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30

# Google Sign-In ("Continue with Google" on Login/Register). Create a Web-app
# OAuth Client ID at https://console.cloud.google.com/apis/credentials and add
# your frontend origin to its Authorized JavaScript origins. Public value — the
# frontend reads it from /api/auth/config. Leave blank to hide the button.
GOOGLE_SIGNIN_CLIENT_ID=

# Optional deploy helpers (used by tooling, not the server runtime).
GITHUB_TOKEN=
GITHUB_REPO=

# Web Push (VAPID). Generate a keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Public key is sent to the browser; private key signs push messages.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Angel One SmartAPI (primary market-data source)
# Sign up at https://smartapi.angelbroking.com and enable TOTP 2FA on your trading account.
# ANGEL_TOTP must be the TOTP SECRET (base32 string shown when you set up 2FA),
# NOT a live 6-digit OTP — the server generates fresh codes on every login.
ANGEL_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP=

# Single Angel SmartWebSocketV2 live tick feed (one connection, fans out to all
# clients). Off by default; set to 1 to make it the primary tick source with
# REST as automatic fallback.
ANGEL_FEED_WS=

# ── Market-data provider (cash-equity / index FALLBACK behind Angel One) ──
# Yahoo is no longer primary (rate-limited). The provider chain serves the
# equity/index slice when Angel can't; calls fail over down the chain with
# Yahoo as the no-key last resort. Angel One stays primary for MCX/options.
# Recommended primary for this Indian paper-trading app: twelvedata.
#   providers: twelvedata | polygon | finnhub | yahoo
MARKET_DATA_PROVIDER=twelvedata
# Optional extra fallbacks (comma-separated), e.g. "finnhub,polygon".
MARKET_DATA_FALLBACK=
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
