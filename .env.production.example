# ─────────────────────────────────────────────────────────────────────────────
# Tradar backend — PRODUCTION env (GCP VM).  Copy to ".env" on the server:
#     cp .env.production.example .env   &&   nano .env
# NEVER commit the real .env (it's gitignored).
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=production

# ── Database: MongoDB Atlas (free M0) ────────────────────────────────────────
# Atlas → Connect → Drivers → copy the SRV string. Replace <user>/<pass> and add
# the DB name (paper_trading) before the "?". URL-encode special chars in pass.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/paper_trading?retryWrites=true&w=majority

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a long random secret:  openssl rand -hex 48
JWT_SECRET=PASTE_A_LONG_RANDOM_STRING_HERE
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30

# ── URLs ─────────────────────────────────────────────────────────────────────
# CORS_ORIGIN = where your FRONTEND is hosted (comma-separated for several).
# APP_URL     = same frontend origin (used to build email links).
CORS_ORIGIN=https://your-frontend.example.com
APP_URL=https://your-frontend.example.com

DEFAULT_BALANCE=100000
PRICE_TICK_MS=1500

# ── Angel One SmartAPI (market data) ─────────────────────────────────────────
ANGEL_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP=

# ── Google Sign-In (public client id; blank = button hidden) ─────────────────
GOOGLE_SIGNIN_CLIENT_ID=

# ── Outgoing email (optional — blank = links logged to server console) ───────
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
MAIL_FROM=
RESET_TOKEN_TTL_MIN=30
VERIFY_TOKEN_TTL_MIN=1440

# ── Web Push (optional; generate: node -e "console.log(require('web-push').generateVAPIDKeys())") ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
